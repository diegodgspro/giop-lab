# Copy this file to .env and replace every CHANGE_ME value with a local secret.
# This file intentionally contains placeholders only.
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_POSTGRES_PASSWORD
ZABBIX_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ZABBIX_ADMIN_PASSWORD
TZ=America/Sao_Paulo
ZABBIX_FRONTEND_PORT=8080
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=CHANGE_ME_LOCAL_GLPI_DATABASE_PASSWORD
GLPI_DB_PORT=3306
GLPI_FRONTEND_PORT=8081
# Phase 3 MVP: dedicated integration identity; secret values only in ignored .env.
GIOP_INTEGRATION_MODE=dry-run
GIOP_INTEGRATION_PORT=8090
# Use a random 64-character hexadecimal value. Enable-GiopZabbixDelivery.ps1
# copies ONLY this key to ignored .env.zabbix-alert for read-only script access.
GIOP_WEBHOOK_SECRET=CHANGE_ME_RANDOM_AT_LEAST_32_CHARACTERS
GLPI_INTEGRATION_USERNAME=giop-lab-zabbix-glpi
GLPI_INTEGRATION_PASSWORD=CHANGE_ME_DEDICATED_PASSWORD
GLPI_INTEGRATION_OAUTH_CLIENT_ID=CHANGE_ME_DEDICATED_CLIENT_ID
GLPI_INTEGRATION_OAUTH_CLIENT_SECRET=CHANGE_ME_DEDICATED_CLIENT_SECRET
# Zabbix provisioning: defaults to local frontend, Admin + ZABBIX_ADMIN_PASSWORD.
# Alternatively configure a Super admin API token or explicit API username/password.
# ZABBIX_API_URL=http://127.0.0.1:8080/api_jsonrpc.php
# ZABBIX_API_TOKEN=CHANGE_ME_LOCAL_ZABBIX_API_TOKEN
# ZABBIX_API_USERNAME=CHANGE_ME_API_USERNAME
# ZABBIX_API_PASSWORD=CHANGE_ME_API_PASSWORD
# Required only when creating giop-lab-notifications; existing password is never reset.
ZABBIX_NOTIFICATION_PASSWORD=CHANGE_ME_RANDOM_NOTIFICATION_ACCOUNT_PASSWORD
# Phase 4 optional read-identity overrides. Existing LAB credentials are fallbacks.
# Store configured values ONLY in ignored .env; no credentials reach the browser.
# CONTROL_CENTER_ZABBIX_API_TOKEN=CHANGE_ME_READ_API_TOKEN
# CONTROL_CENTER_ZABBIX_USERNAME=CHANGE_ME_READ_USERNAME
# CONTROL_CENTER_ZABBIX_PASSWORD=CHANGE_ME_READ_PASSWORD
# CONTROL_CENTER_GLPI_USERNAME=CHANGE_ME_READ_USERNAME
# CONTROL_CENTER_GLPI_PASSWORD=CHANGE_ME_READ_PASSWORD
# CONTROL_CENTER_GLPI_CLIENT_ID=CHANGE_ME_READ_CLIENT_ID
# CONTROL_CENTER_GLPI_CLIENT_SECRET=CHANGE_ME_READ_CLIENT_SECRET
